# ==========================================================================
# Hello Ivy — environment variables
# Copy to .env and fill in. Never commit .env.
# ==========================================================================

# --- Language model (REQUIRED) --------------------------------------------
# Free key from https://aistudio.google.com/apikey
# Gemini's free tier covers the interviewer, extractor, strategist, speech-to-
# text and text-to-speech used by this app.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides. The defaults below are all on the free tier.
# Google retires model ids periodically; these can be re-pointed without a
# code change. Check https://ai.google.dev/gemini-api/docs/models for current ids.
# IVY_FAST_MODEL=gemini-3.5-flash-lite
# IVY_STRATEGY_MODEL=gemini-3.5-flash
# IVY_STT_MODEL=gemini-3.5-transcribe
# IVY_TTS_MODEL=gemini-3.1-flash-tts-preview
# IVY_TTS_VOICE=Aoede

# --- Supabase (REQUIRED) ---------------------------------------------------
# From your project's API settings: https://supabase.com/dashboard
# The anon key is safe in the browser; the service role key must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (REQUIRED for `npm run migrate`) -----------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the direct (non-pooling) connection so DDL statements work.
POSTGRES_URL_NON_POOLING=
